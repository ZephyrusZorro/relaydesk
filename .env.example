# Setup scripts generate real random keys in the ignored .env file.
RELAYDESK_INTERNAL_KEY=replace-with-64-random-hex-characters
N8N_ENCRYPTION_KEY=replace-with-a-different-random-key
RELAYDESK_PORT=18080
RELAYDESK_N8N_PORT=15678
RELAYDESK_OLLAMA_URL=http://host.docker.internal:11434
RELAYDESK_OLLAMA_MODEL=llama3.2:3b
# Optional shared portal access key. For a local single-user demo it may stay empty.
RELAYDESK_PORTAL_KEY=
